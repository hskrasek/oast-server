#!/bin/sh
set -eu

# A fresh install exposed with the documented placeholder (or a trivially
# guessable secret) would let anyone authorize /setup and create the sole
# owner account. Unset is allowed: the app then rejects all /setup
# authorization attempts, which fails closed.
secret="${OAST_BOOTSTRAP_SECRET:-}"
if [ -z "$secret" ]; then
    exit 0
fi

if [ "$secret" = "replace-with-a-high-entropy-secret" ]; then
    echo "OAST_BOOTSTRAP_SECRET must not be the documented placeholder." >&2
    exit 64
fi

if [ "${#secret}" -lt 16 ]; then
    echo "OAST_BOOTSTRAP_SECRET must be at least 16 characters." >&2
    exit 64
fi

exit 0
